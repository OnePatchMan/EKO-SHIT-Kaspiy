            "type": "string",
            "title": "Station Id"
          },
          "before_at": {
            "type": "string",
            "title": "Before At"
          },
          "after_at": {
            "type": "string",
            "title": "After At"
          },
          "aligned": {
            "type": "boolean",
            "title": "Aligned",
            "default": false
          },
